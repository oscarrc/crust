---
import { ClientRouter } from "astro:transitions";
import { Toaster } from "@oscarrc/crust/react";
import "@oscarrc/crust/styles.css";

interface Props {
  title?: string;
}

const { title = "Crust — toasts for Astro & React" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Don't throw the crust. An opinionated, crisp toast library built natively for Astro and React."
    />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=Fragment+Mono&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>🍞 Crust</a>
      <nav>
        <a href={`${base}docs/`}>Docs</a>
        <a href="https://github.com/oscarrc/crust">GitHub</a>
        <a href="https://www.npmjs.com/package/@oscarrc/crust">npm</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>MIT · baked by <a href="https://oscarrc.github.io">Oscar Rey</a></p>
    </footer>
    <Toaster client:load transition:persist="crust-toaster" />
  </body>
</html>

<style is:global>
  :root {
    --paper: oklch(0.97 0.008 80);
    --paper-raised: oklch(0.99 0.005 80);
    --ink: oklch(0.28 0.02 60);
    --ink-soft: oklch(0.45 0.018 60);
    --line: oklch(0.88 0.012 75);
    --crumb: oklch(0.52 0.1 60); /* crust brown — the docs accent */
    --herb: oklch(0.55 0.12 150);

    --font-display: "Young Serif", serif;
    --font-body: "Hanken Grotesk", sans-serif;
    --font-mono: "Fragment Mono", monospace;

    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 32px;
    --space-xl: 64px;
    --space-2xl: 96px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.15;
    margin: 0;
  }

  a {
    color: var(--crumb);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  code,
  pre {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .site-header {
    position: sticky;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-md) clamp(16px, 5vw, 64px);
    border-bottom: 1px solid var(--line);
    background: var(--paper-raised);
    z-index: 50;
    top: 0;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: var(--space-md);
  }

  .site-header nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-header nav a:hover {
    color: var(--crumb);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 clamp(16px, 5vw, 64px);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: var(--space-2xl);
    padding: var(--space-md) clamp(16px, 5vw, 64px);
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  /* Shared bits used by both pages */
  .btn {
    appearance: none;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink);
    font: 500 0.9rem var(--font-body);
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 1px 2px oklch(0.2 0.01 75 / 0.05);
    transition:
      transform 120ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 120ms;
  }

  .btn:hover {
    border-color: var(--crumb);
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0) scale(0.98);
  }

  .btn-primary {
    background: var(--crumb);
    border-color: var(--crumb);
    color: var(--paper-raised);
  }

  .island {
    border: 1px dashed var(--crumb);
    border-radius: 10px;
    padding: var(--space-md) 20px;
    max-width: 480px;
  }

  .island-label {
    margin: 0 0 var(--space-sm);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--crumb);
  }

  .island-buttons {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  pre.code-block {
    background: oklch(0.3 0.02 60);
    color: oklch(0.92 0.008 80);
    padding: var(--space-md) 20px;
    border-radius: 10px;
    overflow-x: auto;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
