---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import { Toaster } from "@oscarrc/crust/react";
import GitHubIcon from "../assets/github.svg";
import NpmIcon from "../assets/npm.svg";
import "@oscarrc/crust/styles.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Crust - toasts for Astro & React" } = Astro.props;
// BASE_URL has no trailing slash by default. Normalize so `${base}docs/` works.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const socials = await getCollection("socials");
// Resolve each social's `icon` filename to its imported SVG component.
// `typeof GitHubIcon` is the imported-SVG component type, so the resolved
// values type-check as renderable components.
const socialIcons = import.meta.glob<{ default: typeof GitHubIcon }>(
  "../assets/*.svg",
  { eager: true },
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Don't throw the crust. An opinionated, crisp toast library built natively for Astro and React."
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="LLMs Full"
    />
    <Font cssVariable="--font-young-serif" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-fragment-mono" />
    <script is:inline>
      // Theme before first paint: localStorage wins, OS preference is the
      // default. ClientRouter swaps <html> attributes, so re-apply after
      // every swap. Registered once; inline head scripts run on full
      // loads only.
      (() => {
        const apply = () => {
          const stored = localStorage.getItem("theme");
          const dark =
            stored === "dark" ||
            (stored !== "light" &&
              matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
        // The toggle lives in the header, which is replaced on every swap.
        // delegate from document so one listener survives all navigations.
        document.addEventListener("click", (event) => {
          if (!event.target.closest("[data-theme-toggle]")) return;
          const dark = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", dark);
          localStorage.setItem("theme", dark ? "dark" : "light");
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="m-0 flex min-h-screen flex-col">
    <header
      class="sticky top-0 z-50 flex items-baseline justify-between border-b border-line bg-paper-raised px-[clamp(16px,5vw,64px)] py-4"
    >
      <a
        class="font-display text-xl whitespace-nowrap text-ink no-underline"
        href={base}>🍞 Crust</a
      >
      <nav class="flex items-baseline gap-5" aria-label="Site">
        <a
          class="text-sm text-ink-soft no-underline transition-colors hover:text-crumb"
          href={`${base}docs/`}>Docs</a
        >
        <a
          class="text-sm text-ink-soft no-underline transition-colors hover:text-crumb"
          href={`${base}playground/`}>Playground</a
        >
        <a
          class="self-center text-ink-soft transition-colors hover:text-crumb"
          href="https://github.com/oscarrc/crust"
          aria-label="Crust on GitHub"
          target="_blank"
          rel="noopener noreferrer"
        >
          <GitHubIcon width={17} height={17} fill="currentColor" />
        </a>
        <a
          class="self-center text-ink-soft transition-colors hover:text-crumb"
          href="https://www.npmjs.com/package/@oscarrc/crust"
          aria-label="Crust on npm"
          target="_blank"
          rel="noopener noreferrer"
        >
          <NpmIcon width={17} height={17} fill="currentColor" />
        </a>
        <button
          type="button"
          data-theme-toggle
          class="relative -my-1 cursor-pointer self-center rounded-[10px] border border-line bg-paper-raised p-1.5 text-ink-soft transition-colors hover:border-crumb hover:text-crumb"
          aria-label="Toggle color theme"
        >
          <!-- Sun in the light, moon in the dark. Stroke-drawn, brand style. -->
          <svg
            class="block dark:hidden"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.5"></circle>
            <path
              d="M12 2.5v2.5M12 19v2.5M2.5 12h2.5M19 12h2.5M5 5l1.8 1.8M17.2 17.2 19 19M19 5l-1.8 1.8M6.8 17.2 5 19"
            ></path>
          </svg>
          <svg
            class="hidden dark:block"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
            ></path>
          </svg>
        </button>
      </nav>
    </header>
    <slot />
    <footer
      class="mt-24 flex flex-col items-center gap-4 border-t border-line px-[clamp(16px,5vw,64px)] py-4 text-center text-sm text-ink-soft sm:flex-row sm:justify-between sm:text-left"
    >
      <p class="m-0">
        License: <a
          class="text-crumb underline decoration-1 underline-offset-3"
          href="https://github.com/oscarrc/crust/blob/main/LICENSE"
          target="_blank"
          rel="noopener noreferrer">MIT</a
        >
      </p>
      <p class="m-0 flex items-center gap-1.5">
        Baked with
        <svg
          class="text-crumb"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="currentColor"
          aria-label="love"
          role="img"
        >
          <path
            d="M12 21s-6.716-4.35-9.193-7.78C1.07 10.94 1.45 7.6 3.99 6.13a4.93 4.93 0 0 1 6.01.86L12 9l1.999-2.01a4.93 4.93 0 0 1 6.01-.86c2.54 1.47 2.92 4.81 1.184 7.09C18.716 16.65 12 21 12 21Z"
          ></path>
        </svg>
        <a
          class="text-crumb underline decoration-1 underline-offset-3"
          href="https://oscarrc.me">Oscar R.C.</a
        >
      </p>
      <ul class="m-0 flex list-none items-center gap-4 p-0">
        {
          socials.map((social) => {
            const Icon = socialIcons[`../assets/${social.data.icon}`]?.default;
            return (
              <li>
                <a
                  class="block text-ink-soft transition-colors hover:text-crumb"
                  href={social.data.url}
                  aria-label={`Oscar R.C. on ${social.data.name}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {Icon && <Icon width={17} height={17} fill="currentColor" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </footer>
    <Toaster client:load transition:persist="crust-toaster" />
  </body>
</html>
