---
// Docs shell in the spirit of Astro's classic docs example template:
// markdown pages declare `layout:` frontmatter, this provides the
// sidebar + prose chrome around the rendered content.
import Layout from "./Layout.astro";

interface Props {
  frontmatter: { title: string };
}

const { frontmatter } = Astro.props;
// BASE_URL has no trailing slash by default. Normalize so `${base}docs/` works.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const sidebar = [
  { label: "Getting started", href: `${base}docs/` },
  { label: "API", href: `${base}docs/api/` },
  { label: "Theming & icons", href: `${base}docs/theming/` },
];

const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<Layout title={`${frontmatter.title} - Crust docs`}>
  <main
    class="mx-auto grid w-full max-w-[960px] flex-1 grid-cols-1 gap-4 px-[clamp(16px,5vw,64px)] pt-8 md:grid-cols-[180px_1fr] md:gap-16"
  >
    <aside>
      <nav class="sticky top-24" aria-label="Docs">
        <ul class="m-0 grid list-none gap-1 p-0">
          {
            sidebar.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "block rounded-lg px-2.5 py-1.5 text-sm no-underline transition-colors",
                    current === item.href
                      ? "bg-line/60 font-medium text-ink"
                      : "text-ink-soft hover:text-crumb",
                  ]}
                  aria-current={current === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
    <article class="prose prose-crust min-w-0 max-w-[70ch]">
      <h1>{frontmatter.title}</h1>
      <slot />
    </article>
  </main>
</Layout>

<style is:global>
  /* Brand-tuned typography: every prose color points at a semantic token,
     so the dark theme flips the whole article with zero extra rules. */
  .prose-crust {
    --tw-prose-body: var(--ink-soft);
    --tw-prose-headings: var(--ink);
    --tw-prose-lead: var(--ink-soft);
    --tw-prose-links: var(--crumb);
    --tw-prose-bold: var(--ink);
    --tw-prose-counters: var(--crumb);
    --tw-prose-bullets: var(--line);
    --tw-prose-hr: var(--line);
    --tw-prose-quotes: var(--ink);
    --tw-prose-quote-borders: var(--line);
    --tw-prose-captions: var(--ink-soft);
    --tw-prose-code: var(--ink);
    --tw-prose-pre-code: oklch(0.92 0.008 80);
    --tw-prose-pre-bg: oklch(0.27 0.015 60);
    --tw-prose-th-borders: var(--line);
    --tw-prose-td-borders: var(--line);
  }

  .prose-crust h1,
  .prose-crust h2 {
    font-family: var(--font-display);
    font-weight: 400;
  }

  .prose-crust h1 {
    font-size: 2.25rem;
    margin-bottom: 32px;
  }

  .prose-crust h2 {
    font-size: 1.4rem;
    margin-top: 64px;
  }

  .prose-crust h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .prose-crust pre {
    border-radius: 10px;
    line-height: 1.7;
  }

  .prose-crust :not(pre) > code {
    background: oklch(0.93 0.012 75);
    padding: 1px 5px;
    border-radius: 5px;
    font-weight: 400;
  }

  .dark .prose-crust :not(pre) > code {
    background: oklch(0.3 0.014 60);
  }

  .prose-crust :not(pre) > code::before,
  .prose-crust :not(pre) > code::after {
    content: none; /* drop the plugin's backticks */
  }

  .prose-crust blockquote {
    font-style: normal;
    font-weight: 400;
    /* No side-stripe: a quiet raised surface carries the aside instead. */
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
    padding: 12px 20px;
    margin-top: 24px;
  }

  .prose-crust blockquote p:first-of-type::before,
  .prose-crust blockquote p:last-of-type::after {
    content: none;
  }
</style>
