---
import Layout from "../layouts/Layout.astro";
import { Playground } from "../components/Playground";

// BASE_URL has no trailing slash by default — normalize so `${base}docs/` works.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout>
  <main class="mx-auto w-full max-w-[960px] flex-1 px-[clamp(16px,5vw,64px)]">
    <section class="pt-24 pb-16">
      <h1
        class="m-0 font-display text-[clamp(2.75rem,8vw,4.5rem)] leading-[1.15] font-normal tracking-[-0.01em]"
      >
        Don't throw<br />the crust.
      </h1>
      <p class="my-8 max-w-[56ch] text-lg text-ink-soft">
        An opinionated, crisp toast library built natively for Astro and React.
        One store, one renderer, warm matte surfaces — and a capsule that grows
        into a card as a single continuous surface.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <button class="btn btn-primary" data-bake="success">Bake a toast</button
        >
        <a class="btn" href={`${base}docs/`}>Read the docs</a>
      </div>

      <div
        class="mt-10 flex max-w-md items-center justify-between gap-4 rounded-[10px] bg-oven py-3.5 pr-2.5 pl-5"
      >
        <code class="font-mono text-sm text-oven-ink"
          ><span class="select-none text-oven-ink/50">$ </span>pnpm add
          @oscarrc/crust</code
        >
        <button
          type="button"
          class="cursor-pointer rounded-lg p-2 text-oven-ink/70 transition-colors hover:text-oven-ink"
          data-copy="pnpm add @oscarrc/crust"
          aria-label="Copy install command"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            ></path>
          </svg>
        </button>
      </div>
    </section>

    <section class="mt-24">
      <h2 class="m-0 mb-2 font-display text-[1.75rem] font-normal">
        The bakery
      </h2>
      <p class="m-0 max-w-[60ch] text-sm text-ink-soft">
        Every kind of toast, fired from a plain Astro
        <code class="font-mono text-[0.85em]">&lt;script&gt;</code> — zero React
        in this execution path.
      </p>
      <div class="mt-4 mb-8 flex flex-wrap gap-2">
        <button class="btn" data-bake="success">Success</button>
        <button class="btn" data-bake="error">Error</button>
        <button class="btn" data-bake="info">Info</button>
        <button class="btn" data-bake="warning">Warning</button>
        <button class="btn" data-bake="loading">Loading (3s proof)</button>
        <button class="btn" data-bake="promise">Promise (2s bake)</button>
        <button class="btn" data-bake="expand">Expandable (hover it)</button>
        <button class="btn" data-bake="persistent">Persistent</button>
        <button class="btn" data-bake="custom-icon">Custom lucide icon</button>
        <button class="btn" data-bake="spam">Spam ×10</button>
        <button class="btn" data-bake="dismiss">Dismiss all</button>
      </div>

      <Playground client:visible />

      <p class="mt-6 max-w-[60ch] text-sm text-ink-soft">
        Now navigate to the <a
          class="text-crumb underline decoration-1 underline-offset-3"
          href={`${base}docs/`}>docs page</a
        > with a toast still up — it survives the page transition. Crust re-adopts
        its toaster across Astro's view-transition swaps, timers and all.
      </p>
    </section>

    <section class="mt-24">
      <h2 class="m-0 mb-2 font-display text-[1.75rem] font-normal">
        Why Crust
      </h2>
      <ol class="why-list m-0 mt-8 grid list-none gap-8 p-0">
        <li>
          <h3 class="m-0 mb-1 font-display text-[1.15rem] font-normal">
            Astro-first, honestly
          </h3>
          <p class="col-start-2 m-0 text-[0.95rem] text-ink-soft">
            The renderer is vanilla DOM. A React-free Astro site renders toasts
            with <code class="font-mono text-[0.85em]">mountToaster()</code> —
            React is an optional peer, not a requirement.
          </p>
        </li>
        <li>
          <h3 class="m-0 mb-1 font-display text-[1.15rem] font-normal">
            One surface, growing
          </h3>
          <p class="col-start-2 m-0 text-[0.95rem] text-ink-soft">
            Hover a toast with a title and the capsule morphs into a card —
            constant radius, one container, no second panel bolted on.
          </p>
        </li>
        <li>
          <h3 class="m-0 mb-1 font-display text-[1.15rem] font-normal">
            Nothing waits
          </h3>
          <p class="col-start-2 m-0 text-[0.95rem] text-ink-soft">
            Entrances land in 320ms, exits in 200, and interaction is never
            blocked. Timers pause while you read. Reduced motion is a theme,
            not an afterthought.
          </p>
        </li>
        <li>
          <h3 class="m-0 mb-1 font-display text-[1.15rem] font-normal">
            Your site's voice wins
          </h3>
          <p class="col-start-2 m-0 text-[0.95rem] text-ink-soft">
            Fonts inherit from the host page and every color, radius and
            duration is a <code class="font-mono text-[0.85em]">--crust-*</code>
            custom property away.
          </p>
        </li>
      </ol>
    </section>
  </main>
</Layout>

<style>
  /* Editorial numbering — CSS counters read better as a scoped rule than
     as a string of arbitrary-value utilities. */
  .why-list {
    counter-reset: why;
  }

  .why-list li {
    counter-increment: why;
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 16px;
    max-width: 64ch;
  }

  .why-list li::before {
    content: counter(why, decimal-leading-zero);
    font-family: var(--font-mono);
    color: var(--color-crumb);
    font-size: 0.9rem;
    padding-top: 0.45rem;
  }
</style>

<script>
  import { toast } from "@oscarrc/crust/vanilla";
  import { createElement, Croissant } from "lucide";

  const bakes: Record<string, () => void> = {
    success: () =>
      toast.success("Fresh bread out of the oven.", { title: "Bakery live" }),
    error: () =>
      toast.error("The loaf did not survive.", { title: "Burnt toast" }),
    info: () => toast.info("Proofing takes as long as it takes."),
    warning: () =>
      toast.warning("The oven is running hot.", { title: "Mind the heat" }),
    loading: () => {
      // Loading toasts persist until updated — prove toast.update too.
      const id = toast.loading("Proofing the dough…", { title: "Patience" });
      setTimeout(
        () =>
          toast.update(id, {
            type: "success",
            title: "Proofed",
            message: "Risen and ready.",
            duration: 4000,
          }),
        3000,
      );
    },
    promise: () =>
      toast.promise(
        new Promise<string>((resolve, reject) =>
          setTimeout(
            () =>
              Math.random() > 0.3
                ? resolve("sourdough")
                : reject(new Error("it collapsed")),
            2000,
          ),
        ),
        {
          loading: { message: "In the oven…", title: "Baking" },
          success: (loaf) => ({
            message: `One ${loaf}, golden brown.`,
            title: "Fresh bake",
          }),
          error: (e) => ({
            message: `No loaf today — ${(e as Error).message}.`,
            title: "Bake failed",
          }),
        },
      ),
    expand: () =>
      toast(
        "Hover or focus this toast and watch the capsule grow into a card — one surface, constant corners, message revealed. Click to pin it open.",
        {
          title: "Morph-expand",
          type: "info",
          duration: 10_000,
        },
      ),
    persistent: () =>
      toast("This one stays until you dismiss it.", {
        title: "No timer",
        duration: 0,
      }),
    "custom-icon": () =>
      toast.success("Any lucide icon, or your own SVG.", {
        title: "Croissant mode",
        icon: () => createElement(Croissant),
      }),
    spam: () => {
      for (let i = 1; i <= 10; i++) {
        toast(`Order #${i} out of the oven.`, { title: `Batch bake ${i}/10` });
      }
    },
    dismiss: () => toast.dismiss(),
  };

  // Delegate at the document level: this script runs once per full page
  // load, and ClientRouter swaps the <body> on navigation — listeners bound
  // to specific elements would die on the first round trip.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const bake = target.closest<HTMLElement>("[data-bake]");
    if (bake) bakes[bake.dataset.bake!]?.();

    const copy = target.closest<HTMLElement>("[data-copy]");
    if (copy) {
      navigator.clipboard
        .writeText(copy.dataset.copy!)
        .then(() =>
          toast.success("The recipe is on your clipboard.", {
            title: "Copied",
          }),
        )
        .catch(() =>
          toast.error("Clipboard said no — copy it by hand.", {
            title: "No luck",
          }),
        );
    }
  });
</script>
